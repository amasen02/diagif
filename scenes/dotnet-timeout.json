        {
          "x": 530,
          "y": 275
        },
        {
          "x": 530,
          "y": 390
        },
        {
          "x": 142,
          "y": 390
        }
      ]
    },
    {
      "id": "db-token",
      "from": "token",
      "to": "database",
      "pathType": "straight",
      "fromAnchor": "right",
      "toAnchor": "left",
      "colorRole": "mint",
      "label": {
