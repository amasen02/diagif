{
  "id": "mcp-vs-skills",
  "canvas": {
    "width": 800,
    "height": 1000
  },
  "theme": "dark-teal",
  "title": {
    "text": "MCP vs Skills",
    "font": "display",
    "size": 44,
    "align": "center",
    "x": 400,
    "y": 58,
    "accentWords": [
      {
        "word": "MCP",
        "colorRole": "cyan"
      },
      {
        "word": "Skills",
        "colorRole": "orange"
      }
    ],
    "shadow": {
      "kind": "offset",
      "dx": 3,
      "dy": 3
    },
    "subtitle": {
      "text": "Two ways an AI agent reaches useful capabilities",
      "font": "condensed",
      "size": 13
    }
  },
  "brand": {"style":"none"},
  "layout": {
    "kind": "split-comparison",
    "dividerY": 500,
    "labels": [
      "MCP",
      "Skills"
    ],
    "divider": {
      "style": "dotted"
    }
  },
  "nodes": [
    {
      "id": "mcp-host",
      "label": "MCP Host",
      "icon": {
        "name": "laptop"
