{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:diagif:schema:scout-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "generatedAt",
    "candidates"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "title",
          "rationale",
          "sourceIds",
          "signals",
          "virality"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 2,
            "maxLength": 180
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9-]{6,80}$"
            },
            "minItems": 1
          },
          "signals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recency",
              "score",
              "comments"
            ],
            "properties": {
              "recency": {
                "type": "number",
                "minimum": 0
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "comments": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "virality": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "minItems": 1,
      "maxItems": 50
    }
  }
}
