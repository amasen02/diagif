        "count": 2,
        "cyclesPerLoop": 1,
        "colorRole": "orange",
        "size": 9,
        "fadeMs": 160
      },
      {
        "kind": "pulse",
        "nodeIds": [
          "scoped"
        ],
        "cyclesPerLoop": 2,
        "scale": 1.04
      }
    ]
