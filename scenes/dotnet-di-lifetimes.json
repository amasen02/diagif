      "font": "code",
      "fontSize": 16,
      "lines": [
        {
          "text": "services.AddTransient<Worker>();",
          "band": "orange"
        },
        {
          "text": "services.AddScoped<Session>();",
          "band": "cyan"
        },
        {
          "text": "services.AddSingleton<Clock>();",
          "band": "mint"
        }
      ]
    },
    {
      "id": "lifetime-note",
      "kind": "callout",
      "text": "Count resolutions, scopes and providers separately.",
      "x": 500,
      "y": 815,
      "maxWidth": 240,
      "fontSize": 22,
      "colorRole": "neutral",
      "arrow": false
    }
