{
  "id": "cache-stampede-single-flight",
  "canvas": {
    "width": 800,
    "height": 1000
  },
  "theme": "dark-teal",
  "grain": false,
  "title": {
    "text": "One expired key should cause one refresh",
    "lines": [
      "One expired key should cause",
      "one refresh"
    ],
    "font": "display",
    "size": 40,
    "align": "center",
    "x": 400,
    "y": 58,
    "accentWords": [
      {
        "word": "one refresh",
        "colorRole": "orange"
      }
    ],
    "shadow": {
      "kind": "none"
    },
    "subtitle": {
      "text": "COALESCE CONCURRENT MISSES FOR THE SAME CACHE KEY.",
      "font": "condensed",
      "size": 18
    }
  },
  "brand": {"style":"none"},
  "layout": {
    "kind": "split-comparison",
    "divider": {
      "style": "dotted"
    },
    "sections": [
      {
        "id": "section-a",
        "header": "WITHOUT / EVERY MISS LOADS",
        "headerStyle": "chip",
        "y": 156,
        "h": 344,
        "colorRole": "orange"
      },
      {
        "id": "section-b",
        "header": "WITH / SINGLE-FLIGHT",
        "headerStyle": "chip",
        "y": 500,
        "h": 440,
        "colorRole": "mint"
      }
    ]
  },
  "nodes": [
    {
      "id": "requests",
      "label": "10k requests",
      "x": 60,
      "y": 260,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "cyan",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "One hot key expires"
    },
    {
      "id": "cache-miss",
      "label": "Cache miss",
      "x": 310,
      "y": 260,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "orange",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "Redis / key absent",
      "icon": {
        "name": "redis",
        "source": "brand",
        "size": 28
      }
    },
    {
      "id": "database-bad",
      "label": "Database",
      "x": 560,
      "y": 260,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "danger",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "10k competing reads",
      "icon": {
        "name": "postgresql",
        "source": "brand",
        "size": 28
      }
    },
    {
      "id": "single-flight",
      "label": "Single-flight",
      "x": 60,
      "y": 650,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "mint",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "One leader; others wait"
    },
    {
      "id": "database",
      "label": "Database",
      "x": 310,
      "y": 650,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "mint",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "One refresh query",
      "icon": {
        "name": "postgresql",
        "source": "brand",
        "size": 28
      }
    },
    {
      "id": "fresh-value",
      "label": "Fresh value",
      "x": 560,
      "y": 650,
      "w": 170,
      "h": 105,
      "shape": "rounded-rect",
      "colorRole": "success",
      "style": {
        "elevation": "hard"
      },
      "secondaryLabel": "Fill cache; release waiters",
      "icon": {
        "name": "redis",
        "source": "brand",
        "size": 28
      }
    }
