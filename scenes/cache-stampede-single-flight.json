  "edges": [
    {
      "id": "request-miss",
      "from": "requests",
      "to": "cache-miss",
      "pathType": "straight",
      "fromAnchor": "right",
      "toAnchor": "left",
      "colorRole": "orange",
      "label": {
        "text": "miss",
        "pill": true
      }
    },
    {
      "id": "miss-db",
      "from": "cache-miss",
      "to": "database-bad",
      "pathType": "straight",
      "fromAnchor": "right",
      "toAnchor": "left",
      "colorRole": "danger",
      "label": {
        "text": "10k reads",
        "pill": true
      }
    },
    {
      "id": "miss-flight",
      "from": "cache-miss",
      "to": "single-flight",
      "pathType": "orthogonal",
      "fromAnchor": "bottom",
      "toAnchor": "top",
      "colorRole": "mint",
      "label": {
        "text": "coalesce by key",
        "pill": true
      },
      "waypoints": [
        {
          "x": 395,
          "y": 595
        },
        {
          "x": 145,
          "y": 595
        }
      ]
    },
    {
      "id": "flight-db",
      "from": "single-flight",
      "to": "database",
      "pathType": "straight",
      "fromAnchor": "right",
      "toAnchor": "left",
      "colorRole": "mint",
      "label": {
        "text": "1 read",
        "pill": true
      }
    },
    {
      "id": "db-fresh",
      "from": "database",
      "to": "fresh-value",
      "pathType": "straight",
      "fromAnchor": "right",
      "toAnchor": "left",
      "colorRole": "mint",
      "label": {
        "text": "fill",
        "pill": true
      }
    }
  ],
  "annotations": [
    {
      "id": "bad",
      "kind": "cross",
      "attachTo": "database-bad"
    },
    {
      "id": "good",
      "kind": "check",
      "attachTo": "single-flight"
    },
    {
      "id": "stampede-note",
      "kind": "callout",
      "text": "The cache is fast until every miss hits the database at once.",
      "x": 60,
      "y": 419,
      "maxWidth": 285,
      "fontSize": 22,
      "colorRole": "orange",
      "arrow": false
    },
    {
      "id": "shared-note",
      "kind": "callout",
      "text": "Share one promise per key. Clear it on success or failure.",
      "x": 64,
      "y": 811,
      "maxWidth": 340,
      "fontSize": 22,
      "colorRole": "mint",
      "arrow": false
    },
    {
      "id": "scope-note",
      "kind": "callout",
      "text": "Process-local by default. Coordinate across replicas.",
      "x": 489,
      "y": 811,
      "maxWidth": 241,
      "fontSize": 21,
      "colorRole": "neutral",
      "arrow": false
    }
  ],
  "timeline": {
    "durationMs": 6000,
    "fps": 25,
    "loop": true,
    "animations": [
      {
        "kind": "particle-flow",
        "edgeIds": [
          "request-miss",
          "miss-flight",
          "flight-db",
          "db-fresh"
        ],
        "count": 3,
        "cyclesPerLoop": 2,
        "colorRole": "orange",
        "size": 10,
        "fadeMs": 160
      },
      {
        "kind": "pulse",
        "nodeIds": [
          "single-flight"
        ],
        "cyclesPerLoop": 2,
        "scale": 1.035
      }
    ]
  }
}
