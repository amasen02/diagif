      "y": 180,
      "w": 130,
      "h": 76,
      "shape": "rounded-rect",
      "colorRole": "cyan"
    },
    {
      "id": "mcp-client",
      "label": "MCP Client",
      "icon": {
        "name": "settings"
      },
      "x": 300,
      "y": 180,
      "w": 140,
      "h": 76,
      "shape": "rounded-rect",
      "colorRole": "mint"
    },
    {
      "id": "mcp-server",
      "label": "MCP Server",
      "icon": {
        "name": "server"
      },
      "x": 555,
      "y": 180,
      "w": 150,
      "h": 76,
      "shape": "rounded-rect",
      "colorRole": "orange"
    },
    {
      "id": "external-tools",
      "label": "Slack · Gmail · Jira",
      "secondaryLabel": "External systems",
      "icon": {
        "name": "slack",
        "source": "brand"
      },
      "x": 535,
      "y": 335,
      "w": 190,
      "h": 116,
      "shape": "panel",
      "colorRole": "mint"
    },
    {
      "id": "skill-agent",
      "label": "AI Agent",
      "icon": {
        "name": "bot"
      },
      "x": 55,
      "y": 580,
      "w": 130,
      "h": 76,
      "shape": "rounded-rect",
      "colorRole": "cyan"
    },
    {
      "id": "registry",
      "label": "Skill Registry",
      "icon": {
        "name": "folder"
      },
      "x": 305,
      "y": 580,
      "w": 145,
      "h": 76,
      "shape": "rounded-rect",
      "colorRole": "orange"
    },
    {
      "id": "skill-md",
      "label": "SKILL.md",
      "secondaryLabel": "instructions + tools",
      "icon": {
        "name": "file-text"
      },
      "x": 555,
      "y": 545,
      "w": 150,
      "h": 88,
      "shape": "document",
      "colorRole": "mint"
    },
    {
      "id": "skill-tools",
      "label": "Docs · Calendar · Jira",
      "icon": {
        "name": "googlecalendar",
        "source": "brand"
      },
      "x": 555,
      "y": 705,
      "w": 190,
      "h": 116,
      "shape": "panel",
      "colorRole": "cyan"
    }
