  "edges": [
    {
      "id": "e-host-client",
      "from": "mcp-host",
      "to": "mcp-client",
      "pathType": "straight",
      "dashed": true,
      "colorRole": "cyan"
    },
    {
      "id": "e-client-server",
      "from": "mcp-client",
      "to": "mcp-server",
      "pathType": "straight",
      "dashed": true,
      "colorRole": "cyan"
    },
    {
      "id": "e-server-tools",
      "from": "mcp-server",
      "to": "external-tools",
      "pathType": "orthogonal",
      "dashed": true,
      "colorRole": "mint",
      "fromAnchor": "bottom",
      "toAnchor": "top"
    },
    {
      "id": "e-agent-registry",
      "from": "skill-agent",
      "to": "registry",
      "pathType": "straight",
      "dashed": true,
      "colorRole": "orange"
    },
    {
      "id": "e-registry-skill",
      "from": "registry",
      "to": "skill-md",
      "pathType": "straight",
      "dashed": true,
      "colorRole": "orange"
    },
    {
      "id": "e-skill-tools",
      "from": "skill-md",
      "to": "skill-tools",
      "pathType": "straight",
      "dashed": true,
      "colorRole": "mint",
      "fromAnchor": "bottom",
      "toAnchor": "top"
    }
  ],
  "annotations": [
    {
      "id": "a-client",
      "kind": "callout",
      "text": "Translates host requests into MCP protocol messages",
      "x": 250,
      "y": 300,
      "maxWidth": 200,
      "target": "mcp-client",
      "targetAnchor": "bottom"
    },
    {
      "id": "a-skill",
      "kind": "callout",
      "text": "Describes the workflow, rules, output format and constraints",
      "x": 300,
      "y": 695,
      "maxWidth": 210,
      "target": "skill-md",
      "targetAnchor": "left"
    }
  ],
  "timeline": {
    "durationMs": 4000,
    "fps": 25,
    "loop": true,
    "animations": [
      {
        "kind": "marching-dash",
        "edgeIds": [
          "e-host-client",
          "e-client-server",
          "e-server-tools",
          "e-agent-registry",
          "e-registry-skill",
          "e-skill-tools"
        ],
        "dash": 8,
        "gap": 8,
        "speedPxPerSec": 48
      },
      {
        "kind": "particle-flow",
        "edgeIds": [
          "e-host-client",
          "e-client-server",
          "e-server-tools"
        ],
        "count": 2,
        "cyclesPerLoop": 2,
        "colorRole": "orange",
        "size": 10
      },
      {
        "kind": "particle-flow",
        "edgeIds": [
          "e-agent-registry",
          "e-registry-skill",
          "e-skill-tools"
        ],
        "count": 2,
        "cyclesPerLoop": 2,
        "colorRole": "orange",
        "size": 10
      }
    ]
  },
  "grain": false
}
