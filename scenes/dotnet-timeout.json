  "annotations": [
    {
      "id": "insight",
      "kind": "callout",
      "text": "A token carries cancellation. It does not create a deadline.",
      "x": 70,
      "y": 610,
      "maxWidth": 300,
      "fontSize": 22,
      "colorRole": "neutral",
      "arrow": false
    },
    {
      "id": "cooperate",
      "kind": "callout",
      "text": "Cancelling the wait cannot force uncooperative work to stop.",
      "x": 435,
      "y": 610,
      "maxWidth": 300,
      "fontSize": 22,
      "colorRole": "neutral",
      "arrow": false
    },
    {
      "id": "timeout-code",
      "kind": "code",
      "x": 65,
      "y": 730,
      "w": 670,
      "h": 144,
      "language": "text",
      "font": "code",
      "fontSize": 16,
      "lines": [
        {
          "text": "builder.Services.AddRequestTimeouts();",
          "band": "cyan"
        },
        {
          "text": "app.UseRequestTimeouts();",
          "band": "cyan"
        },
        {
          "text": "app.MapGet(\"/reports\", async (CancellationToken ct) =>"
        },
        {
          "text": "    await db.Reports.ToListAsync(ct))",
          "band": "mint"
        },
        {
          "text": "  .WithRequestTimeout(TimeSpan.FromSeconds(2));",
          "band": "orange"
        }
      ]
    }
  ],
  "timeline": {
    "durationMs": 6000,
    "fps": 25,
    "loop": true,
    "animations": [
      {
        "kind": "particle-flow",
        "edgeIds": [
          "request",
          "budget",
          "query"
        ],
        "count": 2,
        "cyclesPerLoop": 3,
        "colorRole": "orange",
        "size": 9,
        "fadeMs": 160
      }
    ]
  }
