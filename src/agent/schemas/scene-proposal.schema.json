{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:diagif:schema:scene-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene",
    "claims",
    "authoringNotes"
  ],
  "properties": {
    "scene": {
      "$ref": "urn:diagif:scene"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "supports"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^fact-[a-z0-9-]{1,80}$"
                },
                {
                  "const": "authoring"
                }
              ]
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 60
    },
    "authoringNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 8
    }
  }
}
